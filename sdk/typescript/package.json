{
  "name": "@coltonkirsten/a12s-client",
  "version": "0.0.0-dev",
  "description": "Typed client for the a12s Controller API: Fleet, status, inbox, events and Services",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "default": "./dist/src/node.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coltonkirsten/a12s.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run check:browser && node --test 'dist/test/*.test.js'",
    "check:browser": "esbuild src/index.ts --bundle --platform=browser --format=esm --log-level=warning --outfile=dist/browser-check.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
