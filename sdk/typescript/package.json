{
  "name": "a12s",
  "version": "0.0.0-dev",
  "description": "TypeScript client for a12s: send work to agent Computers, stream their events and Turns, in Node or the browser",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/node.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/src/node.d.ts",
        "default": "./dist/src/node.js"
      },
      "default": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    },
    "./browser.js": "./dist/a12s.js"
  },
  "files": [
    "dist/src",
    "dist/a12s.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coltonkirsten/a12s.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && npm run check:browser",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/test/*.test.js'",
    "check:browser": "esbuild src/index.ts --bundle --platform=browser --format=esm --log-level=warning --outfile=dist/a12s.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "a12s",
    "agents",
    "claude-code",
    "codex",
    "sdk"
  ]
}
