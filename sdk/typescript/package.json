{
  "name": "@coltonkirsten/a12s-client",
  "version": "0.0.0-dev",
  "description": "Typed client for the a12s Controller API: Fleet, status, inbox, events and Services",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" } },
  "files": ["dist/src"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/coltonkirsten/a12s.git", "directory": "sdk/typescript" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/test/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
