# Copy to a12s.bindings.yaml (git-ignored) and adjust. Maps each credential name
# in fleet.yaml to where it comes from on this machine. Never commit the real file.
credentials:
  # A `claude setup-token` token (sk-ant-oat…), as in the README quickstart: computerd passes it to Claude Code as
  # CLAUDE_CODE_OAUTH_TOKEN. Long-lived and never rotated inside a Computer; no credential file, nothing on disk.
  anthropic: { file: ~/.a12s/anthropic }
  # Codex: an OpenAI API key (raw, becomes OPENAI_API_KEY), or for a ChatGPT login a copy of ~/.codex/auth.json.
  # Codex has no setup-token equivalent: a refresh inside a Computer stays there and is not written back here.
  openai:    { file: ~/.a12s/lab/openai.json }
  github:    { env: GH_TOKEN }
